    {
      "id": "many_layers",
      "name": "Many Layers",
      "gender": "female",
      "source": "sources/female/Many-Layers-FTU-on-planetminecraft-com.png",
      "source_model": "slim",
      "rules": [
        {
          "when": "b - r >= 8 && b - g >= 9 && h >= 222",
          "piece": "coat",
          "slot": "main"
        },
        {
          "when": "b > r + 5 && b >= g + 3",
          "piece": "trousers",
          "slot": "main"
        },
        {
          "when": "max(r, g, b) - min(r, g, b) <= 4 && r >= 70 || r >= 180 && g >= 175 && b >= 160",
          "piece": "coat",
          "slot": "decor_1"
        },
        {
          "when": "group == 'leg'",
          "piece": "boots",
          "slot": "main"
        },
        {
          "when": "group == 'body'",
          "piece": "corset",
          "slot": "main"
        }
      ],
      "default": {
        "piece": "coat",
        "slot": "fixed"
      },
      "descriptions": {
        "coat": {
          "main": "Фиолетовая ткань",
          "decor_1": "Светлая обшивка и белые вставки"
        },
        "corset": {
          "main": "Корсет и кожаные детали торса"
        },
