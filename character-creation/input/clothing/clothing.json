          "slot": "main",
          "note": "legs first: boot shadows share a hue with the light stripes"
        },
        {
          "when": "group == 'leg'",
          "piece": "trousers",
          "slot": "main"
        },
        {
          "when": "r > g * 2 && abs(g - b) <= 4",
          "piece": "shirt",
          "slot": "main"
        },
        {
          "when": "r > g && g > b && h > 7 && h < 19 && s > 0.3",
          "piece": "shirt",
          "slot": "decor_1"
        },
        {
          "when": "max(r, g, b) - min(r, g, b) <= 15 && group == 'body' && row >= 7",
          "piece": "trousers",
          "slot": "main"
        },
        {
          "when": "group == 'arm'",
          "piece": "shirt",
          "slot": "decor_2",
          "note": "sleeve bands"
        },
        {
          "when": "group == 'body' && row >= 5",
          "piece": "belt",
          "slot": "main"
        }
      ],
      "default": {
        "piece": "shirt",
        "slot": "decor_2"
      },
      "descriptions": {
        "shirt": {
          "main": "Красные полосы",
          "decor_1": "Светлые полосы",
          "decor_2": "Ворот и ремешки рукавов"
        }
      }
    }
  ]
}
